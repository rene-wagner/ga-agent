{
  "name": "ga-agent",
  "version": "0.1.0",
  "private": true,
  "description": "CLI zum Ausführen von LangGraph-Agents",
  "type": "module",
  "bin": {
    "ga-agent": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings src tests"
  },
  "dependencies": {
    "@langchain/core": "^1.2.18",
    "@langchain/langgraph": "^1.5.1",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
